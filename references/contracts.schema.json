{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-worktree-release:contracts:1",
  "title": "Multi-Worktree Release Contracts",
  "x-historical-validation": {
    "schema_version": 1,
    "cli_pairs": [
      {"previous": "--previous-plan", "current": "--plan", "diagnostic": "H01"},
      {"previous": "--previous-worker-card", "current": "--worker-card-json", "diagnostic": "H02"},
      {"previous": "--previous-master-card", "current": "--master-card-json", "diagnostic": "H03"}
    ],
    "results": ["PASS", "FAIL", "NOT_RUN"],
    "diagnostic_ids": [
      "H01", "H02", "H03", "H04", "H05", "H06", "H07", "H08", "H09", "H10", "H11", "H12", "H13",
      "H14", "H15", "H16", "H17", "H18", "H19", "H20", "H21", "H22", "H23", "H24", "H25", "H26",
      "H27", "H28", "H29", "H30", "H31"
    ]
  },
  "type": "object",
  "$defs": {
    "digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "required_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonical_value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/canonical_value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/canonical_value"}}
      ]
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*//)[^/\\\\]+(?:/[^/\\\\]+)*/?$"
    },
    "task_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "task_derived_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recompute_on_master"],
      "properties": {
        "recompute_on_master": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "service_tier", "selection_reason"],
      "properties": {
        "model": {"enum": ["gpt-5.6-sol", "gpt-5.6-luna"]},
        "reasoning_effort": {"enum": ["high", "max"]},
        "service_tier": {"enum": ["default", "priority"]},
        "selection_reason": {
          "enum": [
            "owner-default:master",
            "owner-default:ordinary-worker",
            "owner-default:complex-worker"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "model": {"const": "gpt-5.6-sol"},
            "reasoning_effort": {"const": "high"},
            "service_tier": {"const": "default"},
            "selection_reason": {"const": "owner-default:master"}
          }
        },
        {
          "properties": {
            "model": {"const": "gpt-5.6-luna"},
            "reasoning_effort": {"const": "max"},
            "service_tier": {"const": "priority"},
            "selection_reason": {"const": "owner-default:ordinary-worker"}
          }
        },
        {
          "properties": {
            "model": {"const": "gpt-5.6-sol"},
            "reasoning_effort": {"const": "high"},
            "service_tier": {"const": "default"},
            "selection_reason": {"const": "owner-default:complex-worker"}
          }
        }
      ]
    },
    "model_owner_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master", "ordinary_worker", "complex_worker"],
      "properties": {
        "master": {"$ref": "#/$defs/model_profile"},
        "ordinary_worker": {"$ref": "#/$defs/model_profile"},
        "complex_worker": {"$ref": "#/$defs/model_profile"}
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "enforced_from_plan_revision", "owner_defaults"],
      "properties": {
        "schema_version": {"const": 1},
        "enforced_from_plan_revision": {"type": "integer", "minimum": 1},
        "owner_defaults": {"$ref": "#/$defs/model_owner_defaults"}
      }
    },
    "authorization_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "real_external_call",
        "create_execution",
        "publish",
        "destructive_operation",
        "target",
        "controlled_input",
        "controlled_input_digest",
        "route",
        "provider",
        "max_calls",
        "max_cost",
        "cost_unit",
        "fresh_execution_required",
        "resume_execution_id",
        "expires_at",
        "envelope_digest"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "real_external_call": {"type": "boolean"},
        "create_execution": {"type": "boolean"},
        "publish": {"type": "boolean"},
        "destructive_operation": {"type": "boolean"},
        "target": {"type": ["string", "null"]},
        "controlled_input": {"$ref": "#/$defs/canonical_value"},
        "controlled_input_digest": {"$ref": "#/$defs/digest"},
        "route": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_cost": {"type": "integer", "minimum": 0},
        "cost_unit": {"type": ["string", "null"]},
        "fresh_execution_required": {"type": "boolean"},
        "resume_execution_id": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "envelope_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "refs"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "x-canonical-order": "utf8"
        },
        "refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "x-canonical-order": "utf8"
        }
      }
    },
    "structured_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "transport", "scope"],
      "properties": {
        "kind": {"enum": ["service", "execution", "publication", "resource"]},
        "id": {"type": "string", "minLength": 1},
        "transport": {"enum": ["local", "remote"]},
        "scope": {"$ref": "#/$defs/target_scope"}
      }
    },
    "authorization_target_service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "transport", "scope"],
      "properties": {
        "kind": {"const": "service"},
        "id": {"type": "string", "minLength": 1},
        "transport": {"const": "remote"},
        "scope": {"$ref": "#/$defs/target_scope"}
      }
    },
    "authorization_target_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "transport", "scope"],
      "properties": {
        "kind": {"const": "execution"},
        "id": {"type": "string", "minLength": 1},
        "transport": {"enum": ["local", "remote"]},
        "scope": {"$ref": "#/$defs/target_scope"}
      }
    },
    "authorization_target_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "transport", "scope"],
      "properties": {
        "kind": {"const": "publication"},
        "id": {"type": "string", "minLength": 1},
        "transport": {"enum": ["local", "remote"]},
        "scope": {"$ref": "#/$defs/target_scope"}
      }
    },
    "authorization_target_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "transport", "scope"],
      "properties": {
        "kind": {"const": "resource"},
        "id": {"type": "string", "minLength": 1},
        "transport": {"enum": ["local", "remote"]},
        "scope": {"$ref": "#/$defs/target_scope"}
      }
    },
    "authorization_grant_external_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "target", "route", "provider", "max_calls", "max_cost", "cost_unit"],
      "properties": {
        "allowed": {"type": "boolean"},
        "target": {"oneOf": [{"$ref": "#/$defs/authorization_target_service"}, {"type": "null"}]},
        "route": {"type": ["string", "null"], "minLength": 1},
        "provider": {"type": ["string", "null"], "minLength": 1},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_cost": {"type": "integer", "minimum": 0},
        "cost_unit": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "authorization_grant_create_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed", "target", "route", "provider", "max_calls", "max_cost", "cost_unit",
        "fresh_execution_required", "resume_execution_id"
      ],
      "properties": {
        "allowed": {"type": "boolean"},
        "target": {"oneOf": [{"$ref": "#/$defs/authorization_target_execution"}, {"type": "null"}]},
        "route": {"type": ["string", "null"], "minLength": 1},
        "provider": {"type": ["string", "null"], "minLength": 1},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_cost": {"type": "integer", "minimum": 0},
        "cost_unit": {"type": ["string", "null"], "minLength": 1},
        "fresh_execution_required": {"type": "boolean"},
        "resume_execution_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "authorization_grant_publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "target", "route", "provider", "max_calls", "max_cost", "cost_unit"],
      "properties": {
        "allowed": {"type": "boolean"},
        "target": {"oneOf": [{"$ref": "#/$defs/authorization_target_publication"}, {"type": "null"}]},
        "route": {"type": ["string", "null"], "minLength": 1},
        "provider": {"type": ["string", "null"], "minLength": 1},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_cost": {"type": "integer", "minimum": 0},
        "cost_unit": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "authorization_grant_destructive_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "target", "route", "provider", "max_calls", "max_cost", "cost_unit"],
      "properties": {
        "allowed": {"type": "boolean"},
        "target": {"oneOf": [{"$ref": "#/$defs/authorization_target_resource"}, {"type": "null"}]},
        "route": {"type": ["string", "null"], "minLength": 1},
        "provider": {"type": ["string", "null"], "minLength": 1},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_cost": {"type": "integer", "minimum": 0},
        "cost_unit": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "authorization_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "capabilities", "controlled_input", "controlled_input_digest", "expires_at", "envelope_digest"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external_call", "create_execution", "publish", "destructive_operation"],
          "properties": {
            "external_call": {"$ref": "#/$defs/authorization_grant_external_call"},
            "create_execution": {"$ref": "#/$defs/authorization_grant_create_execution"},
            "publish": {"$ref": "#/$defs/authorization_grant_publish"},
            "destructive_operation": {"$ref": "#/$defs/authorization_grant_destructive_operation"}
          }
        },
        "controlled_input": {"$ref": "#/$defs/canonical_value"},
        "controlled_input_digest": {"$ref": "#/$defs/digest"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "envelope_digest": {"$ref": "#/$defs/required_digest"}
      }
    },
    "authorization": {
      "oneOf": [
        {"$ref": "#/$defs/authorization_v1"},
        {"$ref": "#/$defs/authorization_v2"}
      ]
    },
    "task_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "task_spec_revision",
        "task_spec_digest",
        "task_spec_path",
        "plan_revision",
        "dispatch_wave",
        "source_thread_id",
        "issued_at",
        "supersedes_task_id",
        "generation",
        "owner_role",
        "worktree",
        "branch",
        "expected_head",
        "task_class",
        "objective",
        "current_state",
        "allowed_paths",
        "forbidden_paths",
        "inputs",
        "outputs",
        "derived_outputs",
        "dependencies",
        "authorization",
        "acceptance",
        "commit_message",
        "stop_conditions"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "task_id": {"type": "string", "minLength": 1},
        "task_spec_revision": {"type": "integer", "minimum": 1},
        "task_spec_digest": {"$ref": "#/$defs/required_digest"},
        "task_spec_path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "dispatch_wave": {"type": "integer", "minimum": 1},
        "source_thread_id": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "supersedes_task_id": {"type": ["string", "null"], "minLength": 1},
        "generation": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1, "pattern": "^/"},
        "branch": {"type": "string", "minLength": 1},
        "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "task_class": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "current_state": {"$ref": "#/$defs/canonical_value"},
        "allowed_paths": {
          "type": "array", "items": {"$ref": "#/$defs/repository_path"}, "uniqueItems": true
        },
        "forbidden_paths": {
          "type": "array", "items": {"$ref": "#/$defs/repository_path"}, "uniqueItems": true
        },
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/task_input"}},
        "outputs": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "derived_outputs": {"$ref": "#/$defs/task_derived_outputs"},
        "dependencies": {"$ref": "#/$defs/task_dependencies"},
        "model_profile": {"$ref": "#/$defs/model_profile"},
        "authorization": {"$ref": "#/$defs/authorization"},
        "acceptance": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "commit_message": {"type": ["string", "null"], "minLength": 1},
        "stop_conditions": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"commit_message": {"type": "null"}},
            "required": ["commit_message"]
          },
          "then": {
            "properties": {
              "task_class": {"type": "string", "pattern": "^independent-read-only(?:-|$)"}
            }
          }
        }
      ]
    },
    "task_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_commits", "parallel_with", "blocked_by"],
      "properties": {
        "upstream_commits": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "uniqueItems": true
        },
        "parallel_with": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "blocked_by": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        }
      }
    },
    "dispatch_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_spec_revision",
        "task_spec_digest",
        "task_spec_path",
        "task_spec_plan_revision",
        "revision_decision",
        "owner_role",
        "worktree",
        "branch",
        "expected_head",
        "acceptance_digest",
        "authorization_envelope_digest",
        "dispatch_status",
        "dispatch_wave",
        "blocked_by",
        "parallel_with"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_spec_revision": {"type": "integer", "minimum": 1},
        "task_spec_digest": {"$ref": "#/$defs/required_digest"},
        "task_spec_path": {"type": "string", "minLength": 1},
        "task_spec_plan_revision": {"type": "integer", "minimum": 1},
        "revision_decision": {"enum": ["NEW", "GRANDFATHER", "REVISE", "SUPERSEDE", "CANCELLED"]},
        "owner_role": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "acceptance_digest": {"$ref": "#/$defs/required_digest"},
        "authorization_envelope_digest": {"$ref": "#/$defs/required_digest"},
        "dispatch_status": {
          "enum": ["READY", "GATED", "PUBLISHED", "BLOCKED", "INTEGRATED", "SUPERSEDED", "CANCELLED"]
        },
        "dispatch_wave": {"type": "integer", "minimum": 1},
        "blocked_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "parallel_with": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "model_profile": {"$ref": "#/$defs/model_profile"}
      }
    },
    "dispatch_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_revision",
        "plan_revision",
        "plan_digest",
        "issued_at",
        "updated_at",
        "release_task_id",
        "issued_by",
        "state_root",
        "task_specs_root",
        "tasks",
        "validation",
        "ready_wave",
        "blocked_tasks"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "record_revision": {"type": "integer", "minimum": 1},
        "plan_revision": {"type": "integer", "minimum": 1},
        "plan_digest": {"$ref": "#/$defs/required_digest"},
        "issued_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "release_task_id": {"type": "string", "minLength": 1},
        "issued_by": {"type": "string", "minLength": 1},
        "state_root": {"type": "string", "minLength": 1},
        "task_specs_root": {"type": "string", "minLength": 1},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/dispatch_task"}},
        "validation": {"$ref": "#/$defs/plan_validation"},
        "ready_wave": {"type": ["integer", "null"], "minimum": 1},
        "blocked_tasks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "model_policy": {"$ref": "#/$defs/model_policy"}
      }
    },
    "plan_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_task_ids",
        "known_dependency_references",
        "acyclic_dependencies",
        "worktree_preflight",
        "semantic_ownership_overlap",
        "persisted_task_specs",
        "task_spec_digests",
        "plan_digest",
        "atomic_persistence"
      ],
      "properties": {
        "unique_task_ids": {"enum": ["PASS", "FAIL"]},
        "known_dependency_references": {"enum": ["PASS", "FAIL"]},
        "acyclic_dependencies": {"enum": ["PASS", "FAIL"]},
        "worktree_preflight": {"enum": ["PASS", "FAIL"]},
        "semantic_ownership_overlap": {"type": ["string", "array"]},
        "persisted_task_specs": {"enum": ["PASS", "FAIL"]},
        "task_spec_digests": {"enum": ["PASS", "FAIL"]},
        "plan_digest": {"enum": ["PASS", "FAIL"]},
        "atomic_persistence": {"enum": ["PASS", "FAIL"]}
      }
    },
    "worker_state": {
      "enum": ["IDLE", "ACTIVE", "AWAITING_INTEGRATION", "BLOCKED"]
    },
    "master_state": {
      "enum": ["IDLE", "ACTIVE", "BLOCKED"]
    },
    "task_outcome": {
      "enum": ["COMPLETED", "CANCELLED", "SUPERSEDED", null]
    },
    "last_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_spec_revision",
        "task_spec_digest",
        "outcome",
        "worker_commit_sha",
        "integrated_as_sha"
      ],
      "properties": {
        "task_id": {"type": ["string", "null"]},
        "task_spec_revision": {"type": ["integer", "null"], "minimum": 1},
        "task_spec_digest": {"$ref": "#/$defs/digest"},
        "outcome": {"$ref": "#/$defs/task_outcome"},
        "worker_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "integrated_as_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "worker_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "record_revision",
        "updated_at",
        "task_id",
        "task_spec_revision",
        "task_spec_digest",
        "task_spec_path",
        "plan_revision",
        "dispatch_wave",
        "source_thread_id",
        "issued_at",
        "supersedes_task_id",
        "worker_generation",
        "frozen_baseline_sha",
        "allowed_paths",
        "forbidden_paths",
        "authorization",
        "acceptance_commands",
        "blocker_kind",
        "blocked_since",
        "recovery_owner",
        "blocker",
        "worker_commit_sha",
        "integrated_as_sha",
        "release_head_sha",
        "last_task"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "state": {"$ref": "#/$defs/worker_state"},
        "record_revision": {"type": "integer", "minimum": 1},
        "updated_at": {"type": "string", "format": "date-time"},
        "task_id": {"type": ["string", "null"]},
        "task_spec_revision": {"type": ["integer", "null"], "minimum": 1},
        "task_spec_digest": {"$ref": "#/$defs/digest"},
        "task_spec_path": {"type": ["string", "null"]},
        "plan_revision": {"type": ["integer", "null"], "minimum": 1},
        "dispatch_wave": {"type": ["integer", "null"], "minimum": 1},
        "source_thread_id": {"type": ["string", "null"]},
        "issued_at": {"type": ["string", "null"], "format": "date-time"},
        "supersedes_task_id": {"type": ["string", "null"]},
        "worker_generation": {"type": ["string", "null"]},
        "frozen_baseline_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "allowed_paths": {"type": "array", "items": {"type": "string"}},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}},
        "authorization": {"$ref": "#/$defs/authorization"},
        "acceptance_commands": {"type": "array", "items": {"type": "string"}},
        "blocker_kind": {
          "enum": ["DEPENDENCY", "ASSIGNMENT", "BASELINE", "OWNERSHIP", "ENVIRONMENT", "AUTHORITY", "WORKTREE", null]
        },
        "blocked_since": {"type": ["string", "null"]},
        "recovery_owner": {"type": ["string", "null"]},
        "blocker": {"type": ["string", "null"]},
        "worker_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "integrated_as_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "release_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "last_task": {"$ref": "#/$defs/last_task"}
      }
    },
    "worker_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_spec_revision",
        "task_spec_digest",
        "plan_revision",
        "dispatch_wave",
        "source_thread_id",
        "role",
        "frozen_baseline_sha",
        "authorization_envelope_digest",
        "acceptance_digest",
        "worker_commit_sha",
        "integrated_as_sha",
        "state"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_spec_revision": {"type": "integer", "minimum": 1},
        "task_spec_digest": {"$ref": "#/$defs/required_digest"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "dispatch_wave": {"type": "integer", "minimum": 1},
        "source_thread_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "frozen_baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "authorization_envelope_digest": {"$ref": "#/$defs/required_digest"},
        "acceptance_digest": {"$ref": "#/$defs/required_digest"},
        "worker_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "integrated_as_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "state": {"enum": ["RECEIVED", "INTEGRATED", "REWORK_REQUESTED"]}
      }
    },
    "candidate_evidence_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_head_sha", "gate_input_digest", "status", "checks"],
      "properties": {
        "release_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "gate_input_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["NONE", "STALE", "PASSED", "FAILED"]},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "result", "evidence_digest"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "result": {"enum": ["PASS", "FAIL"]},
              "evidence_digest": {"$ref": "#/$defs/required_digest"}
            }
          }
        }
      }
    },
    "candidate_input_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "locator", "revision", "value_digest"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 96},
        "kind": {
          "enum": [
            "git-commit", "git-tree", "file", "dispatch-plan", "task-spec", "acceptance",
            "gate-registry", "projection", "toolchain", "authorization"
          ]
        },
        "locator": {"type": "string", "minLength": 1, "maxLength": 512},
        "revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "value_digest": {"$ref": "#/$defs/required_digest"}
      }
    },
    "candidate_observed_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "value_digest"],
      "properties": {
        "locator": {"type": "string", "minLength": 1, "maxLength": 512},
        "value_digest": {"$ref": "#/$defs/required_digest"}
      }
    },
    "candidate_registry_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id", "check_revision", "command_spec", "command_spec_digest", "runner_policy",
        "runner_policy_digest", "input_source_ids"
      ],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 96},
        "check_revision": {"type": "integer", "minimum": 1},
        "command_spec": {"$ref": "#/$defs/canonical_value"},
        "command_spec_digest": {"$ref": "#/$defs/required_digest"},
        "runner_policy": {"$ref": "#/$defs/canonical_value"},
        "runner_policy_digest": {"$ref": "#/$defs/required_digest"},
        "input_source_ids": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 96},
          "x-canonical-order": "utf8"
        }
      }
    },
    "candidate_registry_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id", "gate_revision", "required", "gate_definition", "gate_definition_digest", "runner_policy",
        "runner_policy_digest", "checks"
      ],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 96},
        "gate_revision": {"type": "integer", "minimum": 1},
        "required": {"type": "boolean"},
        "gate_definition": {"$ref": "#/$defs/canonical_value"},
        "gate_definition_digest": {"$ref": "#/$defs/required_digest"},
        "runner_policy": {"$ref": "#/$defs/canonical_value"},
        "runner_policy_digest": {"$ref": "#/$defs/required_digest"},
        "checks": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/candidate_registry_check"}
        }
      }
    },
    "candidate_check_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id", "check_revision", "command", "input_source_ids", "result", "input_digest",
        "evidence_digest", "execution_ref", "exit_code", "stdout_digest", "stderr_digest",
        "observed_artifacts", "runner_digest", "observed_at"
      ],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 96},
        "check_revision": {"type": "integer", "minimum": 1},
        "command": {"type": "string", "minLength": 1, "maxLength": 1024},
        "input_source_ids": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 96},
          "x-canonical-order": "utf8"
        },
        "result": {"enum": ["PASS", "FAIL"]},
        "input_digest": {"$ref": "#/$defs/required_digest"},
        "evidence_digest": {"$ref": "#/$defs/required_digest"},
        "execution_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "exit_code": {"type": "integer"},
        "stdout_digest": {"$ref": "#/$defs/required_digest"},
        "stderr_digest": {"$ref": "#/$defs/required_digest"},
        "observed_artifacts": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/candidate_observed_artifact"}
        },
        "runner_digest": {"$ref": "#/$defs/required_digest"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "candidate_gate_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id", "gate_revision", "required", "status", "input_digest", "evidence_digest",
        "input_sources", "checks", "invalidation_reason"
      ],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 96},
        "gate_revision": {"type": "integer", "minimum": 1},
        "required": {"type": "boolean"},
        "status": {"enum": ["NONE", "STALE", "PASSED", "FAILED"]},
        "input_digest": {"$ref": "#/$defs/digest"},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "input_sources": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/candidate_input_source"}
        },
        "checks": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/candidate_check_v2"}
        },
        "invalidation_reason": {
          "enum": [
            null, "INPUT_SOURCE_CHANGED", "HEAD_CHANGED", "LEGACY_AGGREGATE_ONLY", "REGISTRY_AMBIGUOUS",
            "MAPPING_AMBIGUOUS", "DIGEST_UNVERIFIABLE", "PROVENANCE_UNVERIFIABLE", "REVISION_MIXED",
            "ATOMICITY_UNPROVEN", "INFRASTRUCTURE_ERROR"
          ]
        }
      }
    },
    "candidate_legacy_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "original_digest", "original"],
      "properties": {
        "reason": {"const": "LEGACY_AGGREGATE_ONLY"},
        "original_digest": {"$ref": "#/$defs/required_digest"},
        "original": {"$ref": "#/$defs/candidate_evidence_v1"}
      }
    },
    "candidate_evidence_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "release_task_id", "release_head_sha", "plan_revision", "plan_digest",
        "gate_registry_digest", "gate_registry", "gate_input_digest", "status", "legacy", "gates"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "release_task_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "release_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "plan_revision": {"type": ["integer", "null"], "minimum": 1},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "gate_registry_digest": {"$ref": "#/$defs/digest"},
        "gate_registry": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/candidate_registry_gate"}
        },
        "gate_input_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["NONE", "STALE", "PASSED", "FAILED"]},
        "legacy": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate_legacy_audit"}]},
        "gates": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/candidate_gate_v2"}
        }
      }
    },
    "candidate_evidence": {
      "oneOf": [
        {"$ref": "#/$defs/candidate_evidence_v1"},
        {"$ref": "#/$defs/candidate_evidence_v2"}
      ]
    },
    "master_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "record_revision",
        "updated_at",
        "release_task_id",
        "plan_revision",
        "dispatch_plan_path",
        "dispatch_plan_digest",
        "frozen_baseline_sha",
        "worker_handoffs",
        "candidate_evidence",
        "blocker"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "state": {"$ref": "#/$defs/master_state"},
        "record_revision": {"type": "integer", "minimum": 1},
        "updated_at": {"type": "string", "format": "date-time"},
        "release_task_id": {"type": ["string", "null"]},
        "plan_revision": {"type": ["integer", "null"], "minimum": 1},
        "dispatch_plan_path": {"type": ["string", "null"]},
        "dispatch_plan_digest": {"$ref": "#/$defs/digest"},
        "frozen_baseline_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "worker_handoffs": {"type": "array", "items": {"$ref": "#/$defs/worker_handoff"}},
        "candidate_evidence": {"$ref": "#/$defs/candidate_evidence"},
        "blocker": {"type": ["string", "null"]}
      }
    }
  }
}
